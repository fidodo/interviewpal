# Database (Postgres — e.g. Neon's pooled connection string, required for serverless hosting)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
# OAuth Client ID from https://console.cloud.google.com/apis/credentials (also used by client/.env as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=""

# Seeded accounts (used only by prisma/seed.ts, run once)
SEED_USER_1_EMAIL="you@example.com"
SEED_USER_1_PASSWORD="change-me"
SEED_USER_2_EMAIL="partner@example.com"
SEED_USER_2_PASSWORD="change-me-too"

# AI provider: "gemini", "grok" (xAI), or "groq"
AI_PROVIDER="gemini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

XAI_API_KEY=""
XAI_MODEL="grok-beta"

GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

PORT=4000
CLIENT_URL="http://localhost:5173"
