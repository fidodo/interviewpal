# Database (Postgres — e.g. Neon's pooled connection string, required for serverless hosting)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
# OAuth Client ID from https://console.cloud.google.com/apis/credentials (also used by client/.env as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=""

# Seeded accounts (used only by prisma/seed.ts, run once)
SEED_USER_1_EMAIL="you@example.com"
SEED_USER_1_PASSWORD="change-me"
SEED_USER_2_EMAIL="partner@example.com"
SEED_USER_2_PASSWORD="change-me-too"

# AI provider: "gemini", "grok" (xAI), "groq", "mistral", "cloudflare" or "ollama"
AI_PROVIDER="gemini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

XAI_API_KEY=""
XAI_MODEL="grok-4"

GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Mistral (console.mistral.ai). As of 2026-11-24 the free plan only allows the Ministral models (2 requests a
# minute), so it's left out of the recommended chain below.
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-large-4"

# Cloudflare Workers AI: a free daily allowance (about 60-70 marking calls). Free account, then
# dash.cloudflare.com -> AI -> Workers AI -> "Use REST API" for the account id and an API token.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
CLOUDFLARE_MODEL="@cf/openai/gpt-oss-120b"

# Ollama: a model on your own computer, free and unlimited (ollama.com; then `ollama pull gpt-oss:20b`).
# Local development only: a deployed server can't reach your computer, so production skips it.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="gpt-oss:20b"

# Optional fallback order: each call moves to the next provider when one is rate limited or down, and a provider
# whose allowance is used up is skipped until it resets. "provider:model" uses another model with the same key;
# each Groq model has its own free allowance (gpt-oss-20b's is shared with RAG Lab).
# AI_PROVIDERS="groq,gemini,groq:openai/gpt-oss-20b,cloudflare,ollama"

PORT=4000
CLIENT_URL="http://localhost:5173"
# RAG Lab's model for the learner's ip.llm calls, separate from the interview model: "groq" (default, free) or "gemini"
RAG_LAB_PROVIDER=
RAG_LAB_MODEL=
# Email through Resend (optional): verification, password reset and the daily reminder. Without a key, accounts stay
# unverified and links are printed to the server console in development.
RESEND_API_KEY=
EMAIL_FROM=
# Shared secret for the Vercel Cron call to /api/cron/daily-reminder (sent as "Authorization: Bearer <secret>")
CRON_SECRET=
# "production" in production (hides internal error messages, trusts the Vercel proxy)
NODE_ENV=
