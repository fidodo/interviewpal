datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String?
  googleId     String?            @unique
  createdAt    DateTime           @default(now())
  sessions     InterviewSession[]
  kidsPinHash   String?
  children      ChildProfile[]
  // Set by email-link verification or a Google sign-in. Unverified password accounts lose their password if
  // Google later proves someone else owns the email (stops pre-registration account takeover).
  emailVerified Boolean            @default(false)
  // Bumped on logout / password reset; tokens carrying an older version are rejected.
  tokenVersion  Int                @default(0)
  // Exempt from the daily AI allowance.
  isAdmin       Boolean            @default(false)
  topics        Topic[]
  authTokens    AuthToken[]
  roles         TargetRole[]
  courses       LearnCourse[]
  reviewItems   ReviewItem[]
  debugs        DebugChallenge[]
}

// Preset topics have no owner and are visible to everyone; custom topics belong to the user who created them.
model Topic {
  id        String             @id @default(cuid())
  name      String
  track     String
  isCustom  Boolean            @default(false)
  ownerId   String?
  owner     User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  sessions  InterviewSession[]

  @@unique([name, track, ownerId])
}

// Single-use links sent by email. Only a SHA-256 of the token is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Rate-limit counters shared by every server instance (serverless memory isn't).
model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime
}

model InterviewSession {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  topicId    String
  topic      Topic           @relation(fields: [topicId], references: [id])
  track      String
  difficulty String
  status     String          @default("ACTIVE")
  startedAt  DateTime        @default(now())
  endedAt    DateTime?
  questions  Question[]
  summary    SessionSummary?
  // Set when the session practises for a target role; graded answers then update that role's skill ratings.
  roleId     String?
  role       TargetRole?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  focusSkill String?
  // "PRACTICE" (one question at a time, instant feedback) or "MOCK" (fixed rounds, feedback held until the end).
  mode       String          @default("PRACTICE")
  // Interviewer style (see server/src/ai/personas.ts).
  persona    String          @default("NEUTRAL")
}

model Question {
  id          String           @id @default(cuid())
  sessionId   String
  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text        String
  type        String           @default("VERBAL")
  order       Int
  generatedAt DateTime         @default(now())
  answer      Answer?
  // JSON array of the role skill names this question tests (empty outside role practice).
  skillTags   String           @default("[]")
  // Mock interviews only: BEHAVIOURAL, ROLE or CLOSING.
  round       String?
  // CODING questions: JSON { functionName, params, tests: [{ args, expected }] } so answers can be run in the browser.
  codeSpec    String?
}

model Answer {
  id          String   @id @default(cuid())
  questionId  String   @unique
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  transcript  String
  fillerStats String?
  // Runnable coding answers: JSON { language, passed, total } from the browser test run.
  testResults String?
  submittedAt DateTime @default(now())
  feedback    Feedback?
}

model Feedback {
  id               String @id @default(cuid())
  answerId         String @unique
  answer           Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  score            Int
  correctnessScore Int?
  clarityScore     Int?
  depthScore       Int?
  strengths        String
  weaknesses       String
  suggestions      String
  createdAt        DateTime @default(now())
}

model SessionSummary {
  id           String           @id @default(cuid())
  sessionId    String           @unique
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore Int
  assessment   String
  strengths    String
  improvements String
  generatedAt  DateTime         @default(now())
  // Mock interviews only: HIRE, LEAN_HIRE or NO_HIRE, and a JSON array of { round, score } averages.
  verdict      String?
  roundScores  String?
}

// ---- Kids section (see server/src/kids). Profiles belong to a parent User; children have no login. ----

model ChildProfile {
  id          String       @id @default(cuid())
  parentId    String
  parent      User         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  displayName String
  age         Int
  avatar      String
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

model Course {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  subject     String
  description String
  published   Boolean       @default(true)
  levels      CourseLevel[]
  enrollments Enrollment[]
}

model CourseLevel {
  id               String @id @default(cuid())
  courseId         String
  course           Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  concepts         String
  editor           String
  toolbox          String @default("[]")
  challengesToPass Int    @default(3)

  @@unique([courseId, order])
}

model Enrollment {
  id            String       @id @default(cuid())
  childId       String
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentLevel  Int          @default(1)
  passedAtLevel Int          @default(0)
  createdAt     DateTime     @default(now())
  challenges    Challenge[]

  @@unique([childId, courseId])
}

model Challenge {
  id             String        @id @default(cuid())
  enrollmentId   String
  enrollment     Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  levelOrder     Int
  title          String
  story          String
  instructions   String
  kind           String
  starterCode    String
  expectedOutput String?
  sampleInput    String?
  status         String        @default("OPEN")
  createdAt      DateTime      @default(now())
  attempts       Attempt[]
  messages       HelpMessage[]
}

model Attempt {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  code        String
  output      String
  passed      Boolean
  stars       Int
  praise      String
  nextStep    String
  createdAt   DateTime  @default(now())
}

model HelpMessage {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  role        String
  text        String
  createdAt   DateTime  @default(now())
}

// ---- Target roles (Phase 2 of docs/roadmap.md) ----

// The job a user is working towards. Exactly one role per user is active at a time.
model TargetRole {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  level          String
  targetDate     DateTime?
  jobDescription String?
  cvSummary      String?
  isTechnical    Boolean            @default(true)
  isActive       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  skills         RoleSkill[]
  goals          WeeklyGoal[]
  sessions       InterviewSession[]
}

// `rating` (1-5) starts from the self-rating and moves with interview evidence; `importance` (1-3) weights readiness.
model RoleSkill {
  id            String             @id @default(cuid())
  roleId        String
  role          TargetRole         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  name          String
  category      String
  description   String             @default("")
  importance    Int                @default(2)
  selfRating    Int?
  rating        Float?
  evidenceCount Int                @default(0)
  createdAt     DateTime           @default(now())
  history       SkillRatingEvent[]
  goals         WeeklyGoal[]
  courses       LearnCourse[]

  @@unique([roleId, name])
}

model SkillRatingEvent {
  id        String    @id @default(cuid())
  skillId   String
  skill     RoleSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  rating    Float
  source    String
  createdAt DateTime  @default(now())
}

model WeeklyGoal {
  id        String     @id @default(cuid())
  roleId    String
  role      TargetRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skillId   String?
  skill     RoleSkill? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  text      String
  weekStart DateTime
  done      Boolean    @default(false)
  createdAt DateTime   @default(now())
}

// ---- "Learn this" courses (Phase 4 of docs/roadmap.md, server/src/learn) ----

// A short AI-written course on one skill of a target role, or on any topic. Lessons are outlined up front and
// written the first time they're opened.
model LearnCourse {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String?
  skill     RoleSkill?    @relation(fields: [skillId], references: [id], onDelete: SetNull)
  title     String
  summary   String        @default("")
  level     String
  context   String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  lessons   LearnLesson[]

  // One course per skill per user (topic courses have no skill; NULLs don't collide).
  @@unique([userId, skillId])
}

model LearnLesson {
  id          String          @id @default(cuid())
  courseId    String
  course      LearnCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  objective   String
  // Null until the lesson is first opened.
  content     String?
  completedAt DateTime?
  questions   LearnQuestion[]

  @@unique([courseId, order])
}

// kind MCQ: `options` is a JSON array and `answer` the correct index. kind SHORT: `answer` is a model answer the
// AI marks against. Answers never leave the server until the learner has responded.
model LearnQuestion {
  id          String        @id @default(cuid())
  lessonId    String
  lesson      LearnLesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order       Int
  kind        String
  prompt      String
  options     String        @default("[]")
  answer      String
  explanation String
  responses   LearnAnswer[]
  reviewItems ReviewItem[]
}

model LearnAnswer {
  id         String        @id @default(cuid())
  questionId String
  question   LearnQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response   String
  correct    Boolean
  feedback   String        @default("")
  fromReview Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

// Spaced repetition for questions answered wrongly: `box` 1-4 maps to 1, 3, 7, 14 days; passing box 4 retires it.
model ReviewItem {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   LearnQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  box        Int           @default(1)
  dueAt      DateTime
  createdAt  DateTime      @default(now())

  @@unique([userId, questionId])
  @@index([userId, dueAt])
}

// ---- Debugging practice (Phase 5, server/src/debug) ----

// The AI writes realistic broken code in a chosen stack; the learner fixes it and explains the bug. `bugs` and
// `referenceFix` stay on the server until the challenge is submitted.
model DebugChallenge {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language      String
  level         String
  title         String
  scenario      String
  buggyCode     String
  // Runnable languages only: JSON { functionName, params, tests }.
  spec          String?
  bugs          String
  referenceFix  String
  hintsUsed     Int      @default(0)
  status        String   @default("OPEN")
  submittedCode String?
  explanation   String?
  testResults   String?
  score         Int?
  feedback      String?
  createdAt     DateTime @default(now())
  submittedAt   DateTime?

  @@index([userId, createdAt])
}
